# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# --- Telegram (фаза 1) ---
# my.telegram.org → API development tools → создать приложение
TG_API_ID=
TG_API_HASH=

# --- необязательные переопределения путей и городов ---
# TGTRAFF_ACTIVE_CITIES=magnitogorsk,novokuznetsk,cherepovets
# TGTRAFF_DB_PATH=data/tgtraff.db
# TGTRAFF_MEDIA_DIR=data/media
# TGTRAFF_SESSION=secrets/userbot.session

# --- ВК (фаза 2): сервисный ключ приложения, доступа к аккаунту не даёт ---
VK_SERVICE_TOKEN=

# --- Anthropic (фаза 4): rewriter + relevance + safety + детектор вотермарков ---
# console.anthropic.com → API keys. Бюджет: калибровка $1-3, прод ~$1.2-2/день.
# Без ключа фаза 4 работает только правилами: scripts/drafts.py --dry-run
ANTHROPIC_API_KEY=

# --- боты фазы 5 (модерация, публикация, UGC) ---
BOT_TOKEN_ADMIN=             # @BotFather: админ-бот модерации; он же публикует,
                             # если BOT_TOKEN_PUBLISHER не задан
# BOT_TOKEN_PUBLISHER=       # отдельный бот под публикацию (необязательно)
BOT_TOKEN_UGC=               # бот «Прислать новость» (один на сеть)
ADMIN_CHAT_IDS=              # id модераторов через запятую; посторонним бот не отвечает

# --- каналы публикации (фаза 5) ---
# ТЕСТОВЫЕ каналы. Пока config/channels.yaml в режиме `mode: test`, боевые id
# не используются, даже если заполнены ниже.
TG_CHANNEL_MAGNITOGORSK_TEST=
TG_CHANNEL_NOVOKUZNETSK_TEST=
TG_CHANNEL_CHEREPOVETS_TEST=
# Боевые каналы — заполняются к запуску, включаются переключением mode: live
# TG_CHANNEL_MAGNITOGORSK=
# TG_CHANNEL_NOVOKUZNETSK=
# TG_CHANNEL_CHEREPOVETS=

# --- кросс-постинг в ВК (§41, выключен до появления токенов) ---
# Сервисный ключ выше на стену писать не умеет: нужен токен СООБЩЕСТВА
# с правами wall+photos, и у КАЖДОГО города он свой — сообщество выдаёт ключ
# только на себя (Управление → Работа с API → Создать ключ).
# Порядок включения: завести токен → положить сюда → vk.enabled: true у этого
# города в config/channels.yaml. Города включаются независимо друг от друга.
# VK_GROUP_MAGNITOGORSK=          # числовой id сообщества
# VK_GROUP_TOKEN_MAGNITOGORSK=
# VK_GROUP_NOVOKUZNETSK=
# VK_GROUP_TOKEN_NOVOKUZNETSK=
# VK_GROUP_CHEREPOVETS=
# VK_GROUP_TOKEN_CHEREPOVETS=

# --- отпечаток устройства (должен совпадать с тем, где создана сессия) ---
# TG_DEVICE_MODEL=Desktop
# TG_SYSTEM_VERSION=Windows 10
# TG_APP_VERSION=4.16.8 x64
# TG_LANG_CODE=en
# TG_SYSTEM_LANG_CODE=en

# --- деплой в Docker (фаза 6) ---
# Прокси ТОЛЬКО для контейнера драфтов: с российского IP api.anthropic.com
# отвечает Cloudflare-403 «Request not allowed» (гео-блок, QUESTIONS §52).
# Telegram и ВК ходят напрямую в обход прокси. Пусто — прямое соединение.
# ANTHROPIC_PROXY=http://user:pass@host:port
# LLM_DAILY_BUDGET=4          # суточный потолок расхода на модель, $
# DRAFTS_INTERVAL_SEC=300     # как часто разбирать кластеры
